# Copy this file to ".env" and fill in your keys. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Model names (change if a provider renames or retires a model)
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SMALL_MODEL=llama-3.1-8b-instant
OPENAI_MODEL=gpt-4o-mini

# 1 = use the offline keyword-based test model instead of real providers
MOCK_LLM=0

# Inputs above this many tokens are chunked and summarised
LONG_INPUT_TOKENS=1200
